              "id": "c1",
              "leftValue": "={{ $json.score }}",
              "rightValue": 80,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ad5472c7-5331-576e-8e6f-998e6f8d33e5",
      "name": "Filter High Score (>80)",
