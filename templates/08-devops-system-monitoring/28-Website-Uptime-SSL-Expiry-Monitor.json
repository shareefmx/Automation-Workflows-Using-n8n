{
  "name": "Website Uptime & SSL Expiry Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "59d3286f-9b65-5cc4-9550-e063677a9397",
      "name": "Every 5 Minutes Checker",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/api/health",
        "options": {
          "timeout": 5000
        }
      },
      "id": "749f9496-ff42-54d4-a1d9-8f7e0db52c48",
      "name": "Healthcheck HTTP Ping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "9e09888e-5560-52cc-a729-2db520f28e86",
      "name": "Evaluate Status Code != 200",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "@infra_alerts",
        "text": "🚨 CRITICAL: Service example.com is DOWN! Status code: {{ $json.statusCode }}"
      },
      "id": "aae99af6-e90a-5047-9521-c36eb9c1a8c5",
      "name": "Dispatch Telegram Down Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        200
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Every 5 Minutes Checker": {
      "main": [
        [
          {
            "node": "Healthcheck HTTP Ping",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Healthcheck HTTP Ping": {
      "main": [
        [
          {
            "node": "Evaluate Status Code != 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Status Code != 200": {
      "main": [
        [
          {
            "node": "Dispatch Telegram Down Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "95da98c8-5043-5b06-807e-f205e6fbec7c",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "awesome-n8n-collection"
  },
  "id": "wf-028",
  "tags": [
    {
      "name": "08 Devops System Monitoring",
      "id": "tag-08-devops-system-monitoring"
    }
  ]
}