{
  "name": "Google Forms Quiz Auto-Grader & Certificate Generator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "b4f785f7-1cb8-5b92-969a-3893bbdcb4dd",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "QUIZ_RESPONSES_SHEET",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Submissions",
          "mode": "name"
        }
      },
      "id": "b6aa4316-81ca-5619-a95c-7c188113b5f6",
      "name": "Quiz Submission Trigger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sub = $input.item.json;\nconst score = (sub.q1 === 'A' ? 25 : 0) + (sub.q2 === 'C' ? 25 : 0) + (sub.q3 === 'B' ? 25 : 0) + (sub.q4 === 'D' ? 25 : 0);\nreturn { json: { ...sub, score, passed: score >= 75 } };"
      },
      "id": "05186dfe-4aca-5c1f-b2f3-d4bb00252fa1",
      "name": "Calculate Score Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "🎓 Congratulations! Your Certificate of Completion",
        "message": "=Hi {{ $json.name }},\\n\\nYou scored {{ $json.score }}%! You passed the automation proficiency test."
      },
      "id": "b158f924-291f-529a-9b3d-b2f23c033d35",
      "name": "Send Completion Certificate Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        780,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Quiz Submission Trigger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quiz Submission Trigger": {
      "main": [
        [
          {
            "node": "Calculate Score Code",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Score Code": {
      "main": [
        [
          {
            "node": "Send Completion Certificate Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
