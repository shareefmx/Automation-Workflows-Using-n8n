{
  "name": "AI Phishing & Security Email Screener",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "id": "fc0a236b-b4d4-5fc5-9caa-595a87dd7c29",
      "name": "New Suspicious Email Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Inspect email for security threats: From: {{ $json.from }}, Subject: {{ $json.subject }}, Content: {{ $json.snippet }}. Classify threat level: [Safe, Low, Suspicious, Malicious Phishing]."
      },
      "id": "e6b9648d-53ba-5c2b-9432-1d975bb40322",
      "name": "Gemini Security Risk Evaluator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.threatLevel }}",
              "rightValue": "Malicious Phishing",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b7bd8296-ef5f-5222-931b-7465faf6c45b",
      "name": "Check Malicious",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "postMessage",
        "channel": "#sec-ops",
        "text": "🚨 Phishing Threat Quarantined: {{ $('New Suspicious Email Trigger').item.json.subject }}"
      },
      "id": "7c7a3dbb-eb5f-5d53-98ed-07311e65a420",
      "name": "Post Security Alert to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        880,
        200
      ]
    }
  ],
